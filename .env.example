# AgentSec Lab — copy to .env (never commit .env).
# These values are lab defaults for localhost Docker. Rotate them before any non-localhost bind.

COMPOSE_PROFILES=local
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

AGENTSEC_SECURITY_PROFILE=defended
AGENTSEC_LAB_ID=agentsec-local
AGENTSEC_TESTBED_MODE=auto
AGENTSEC_OTEL_ENABLED=true
OLLAMA_MODEL=llama3.2:1b

# Splunk container admin password (complexity required by the Splunk image).
SPLUNK_PASSWORD=ChangeMeLab!2026
SPLUNK_IMAGE=splunk/splunk:10.2
# Official splunk/splunk images are amd64-only. Apple Silicon uses emulation.
SPLUNK_PLATFORM=linux/amd64

# HEC token is a lab ingest credential, not a production secret.
SPLUNK_HEC_ENDPOINT=http://splunk:8088/services/collector/event
SPLUNK_HEC_TOKEN=lab-hec-token-change-me
SPLUNK_HEC_INDEX=agentsec_telemetry
SPLUNK_HEC_SOURCETYPE=otel:agentic:json
SPLUNK_HEC_SOURCE=agentsec-otel-collector
SPLUNK_HEC_TLS_SKIP_VERIFY=true
