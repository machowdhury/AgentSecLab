# AgentSec Lab — copy to .env (never commit .env).
# These values are lab defaults for localhost Docker. Rotate them before any non-localhost bind.
#
# ./scripts/lab-up.sh forces learner ports onto 127.0.0.1.
# ./scripts/lab-up.sh --remote publishes only 8000, 5001 and 5000 on 0.0.0.0 (see docs/REMOTE_ACCESS.md).
# Optional: set this to the server's public IP or DNS name so scripts print a concrete URL.
# AGENTSEC_PUBLIC_HOST=

COMPOSE_PROFILES=local
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

AGENTSEC_SECURITY_PROFILE=defended
AGENTSEC_LAB_ID=agentsec-local
AGENTSEC_TESTBED_MODE=auto
AGENTSEC_OTEL_ENABLED=true
OLLAMA_MODEL=llama3.2:1b
# Ollama provider. Default: the bundled container Ollama (self-contained, in-mesh only).
# Supported alternative: Ollama running on the host (for example when the container cannot pull the
# model through corporate TLS inspection). Pull the model on the host, start 'ollama serve', then set:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# ./scripts/lab-ready.sh prints which provider AcmeBank is using. Leave unset for the container default.

# Splunk container admin password (complexity required by the Splunk image).
SPLUNK_PASSWORD=ChangeMeLab!2026
SPLUNK_IMAGE=splunk/splunk:10.2
# Official splunk/splunk images are amd64-only. Apple Silicon uses emulation.
SPLUNK_PLATFORM=linux/amd64

# HEC TLS. HTTPS is always on and certificates are always verified.
#   LOCAL_SELF_SIGNED (default): scripts/hec-certs.sh creates a lab certificate once under
#     .certs/ (git-ignored; SANs agentsec_splunk, localhost, 127.0.0.1) and reuses it.
#     It is trusted only through explicit CA files; never added to the OS trust store.
#   EXTERNAL_CERT: you supply the files. Host paths; they are never modified or regenerated.
#     CA_FILE is always required (the trust bundle clients use). CERT_FILE + KEY_FILE are
#     only needed when the bundled Splunk should serve your certificate. For an external
#     HEC service you do not own, set only CA_FILE and SPLUNK_HEC_ENDPOINT (no key needed).
AGENTSEC_HEC_TLS_MODE=LOCAL_SELF_SIGNED
AGENTSEC_HEC_CERT_FILE=
AGENTSEC_HEC_KEY_FILE=
AGENTSEC_HEC_CA_FILE=

# HEC token is a lab ingest credential, not a production secret.
# Use the container DNS name. The compose service alias `splunk` is not
# present on this host's Splunk endpoint. HEC is TLS; HTTP is reset by peer.
SPLUNK_HEC_ENDPOINT=https://agentsec_splunk:8088/services/collector/event
SPLUNK_HEC_TOKEN=lab-hec-token-change-me
SPLUNK_HEC_INDEX=agentsec_telemetry
SPLUNK_HEC_SOURCETYPE=otel:agentic:json
SPLUNK_HEC_SOURCE=agentsec-otel-collector

# --- Optional unified HTTPS gateway (docs/GATEWAY.md). Off unless you use scripts/gateway.sh or docker-compose.gateway.yml ---
# AGENTSEC_PUBLIC_HOST=localhost
# AGENTSEC_PUBLIC_PORT=443              # the ONE public port: 443 (default) or 8000
# AGENTSEC_SPLUNK_LOCAL_PORT=18000      # gateway mode moves Splunk Web here, loopback only
# AGENTSEC_GATEWAY_BIND=127.0.0.1
# AGENTSEC_TLS_MODE=LOCAL_DEV           # or ORG_CERT with the three files below
# AGENTSEC_TLS_CERT_FILE=/path/to/server-cert.pem
# AGENTSEC_TLS_KEY_FILE=/path/to/server.key
# AGENTSEC_TLS_CHAIN_FILE=/path/to/ca-chain.pem
# AGENTSEC_AUTH_FILE=/path/to/htpasswd  # users: learner, operator (hashes only)
# AGENTSEC_ATTACK_TIER=enabled          # or disabled

# --- Optional external Splunk (docs/SPLUNK_INTEGRATION.md). BUNDLED (default) needs none of this. Mock-tested only. ---
# AGENTSEC_SPLUNK_MODE=BUNDLED          # or EXTERNAL_ENTERPRISE / CLOUD
# AGENTSEC_SPLUNK_REST_URL=https://splunk.example.org:8089
# AGENTSEC_SPLUNK_CA_BUNDLE_FILE=/path/to/splunk-ca.pem
# AGENTSEC_SPLUNK_SEARCH_TOKEN_FILE=/path/to/search-only-token   # one line, least privilege

