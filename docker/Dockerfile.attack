FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY schemas/ ./schemas/
COPY learning/academy/curriculum.json ./learning/academy/curriculum.json
# Without this file every Attack UI lab page and "/" fail with HTTP 500 inside the image (framework_refs.references_for).
COPY learning/academy/framework_refs.json ./learning/academy/framework_refs.json
RUN mkdir -p /app/learning/level_1/LAB-PI-001 /app/learning/level_1/LAB-MCP-001 /app/learning/level_1/LAB-RAG-CONTEXT /app/learning/level_1/LAB-MEMORY-001 /app/learning/level_1/LAB-AGENT-GOAL-INTEGRITY-001 /app/learning/level_1/LAB-AGENT-DELEGATION-001 /app/learning/level_1/LAB-AGENTSEC-CAPSTONE-001 /app/learning/level_1/LAB-LOANDESK-001 /app/learning/level_1/LAB-MCP-003 /app/learning/level_1/LAB-MCP-004 /app/learning/level_1/LAB-MCP-005 /app/learning/level_1/LAB-MCP-CATALOG /app/learning/level_1/LAB-MCP-006
COPY learning/level_1/LAB-PI-001/lab-manifest.json ./learning/level_1/LAB-PI-001/lab-manifest.json
COPY learning/level_1/LAB-MCP-001/lab-manifest.json ./learning/level_1/LAB-MCP-001/lab-manifest.json
COPY learning/level_1/LAB-MCP-001/specimens/ ./learning/level_1/LAB-MCP-001/specimens/
COPY learning/level_1/LAB-RAG-CONTEXT/lab-manifest.json ./learning/level_1/LAB-RAG-CONTEXT/lab-manifest.json
COPY learning/level_1/LAB-MEMORY-001/lab-manifest.json ./learning/level_1/LAB-MEMORY-001/lab-manifest.json
COPY learning/level_1/LAB-AGENT-GOAL-INTEGRITY-001/lab-manifest.json ./learning/level_1/LAB-AGENT-GOAL-INTEGRITY-001/lab-manifest.json
COPY learning/level_1/LAB-AGENT-DELEGATION-001/lab-manifest.json ./learning/level_1/LAB-AGENT-DELEGATION-001/lab-manifest.json
COPY learning/level_1/LAB-AGENTSEC-CAPSTONE-001/lab-manifest.json ./learning/level_1/LAB-AGENTSEC-CAPSTONE-001/lab-manifest.json
COPY learning/level_1/LAB-LOANDESK-001/lab-manifest.json ./learning/level_1/LAB-LOANDESK-001/lab-manifest.json
COPY learning/level_1/LAB-MCP-003/lab-manifest.json ./learning/level_1/LAB-MCP-003/lab-manifest.json
COPY learning/level_1/LAB-MCP-004/lab-manifest.json ./learning/level_1/LAB-MCP-004/lab-manifest.json
COPY learning/level_1/LAB-MCP-005/lab-manifest.json ./learning/level_1/LAB-MCP-005/lab-manifest.json
COPY learning/level_1/LAB-MCP-CATALOG/lab-manifest.json ./learning/level_1/LAB-MCP-CATALOG/lab-manifest.json
COPY learning/level_1/LAB-MCP-006/lab-manifest.json ./learning/level_1/LAB-MCP-006/lab-manifest.json
# Security Assurance reads its rules and controls and the committed recorded runs at start-up and per request; without these the service exits at once.
COPY learning/assurance/ ./learning/assurance/
COPY learning/level_1/ ./learning/level_1/

ENV PYTHONPATH=/app/src
ENV AGENTSEC_SCHEMA_PATH=/app/schemas/security_event.schema.json

RUN useradd -m -u 1000 appuser \
    && mkdir -p /app/artifacts /var/lib/agentsec-ctf \
    && chown -R appuser:appuser /app /var/lib/agentsec-ctf   # CTF state (ledger, key): a named volume mounts here in the gateway-ctf overlay

USER appuser

EXPOSE 5001
CMD ["python", "-m", "agentsec.attack_app"]
