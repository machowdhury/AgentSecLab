# AgentSecLab unified gateway. Rendered by the nginx image's envsubst (only AGENTSEC_* variables are substituted).
# Included inside the http{} block. Default-deny: only the allowlisted learner and attack-tier routes are proxied.
server_tokens off;
absolute_redirect off;                       # redirects stay relative: no container port leaks into Location
resolver 127.0.0.11 valid=10s ipv6=off;      # Docker DNS; variable proxy_pass so a late backend never blocks startup
ssl_protocols TLSv1.2 TLSv1.3;
# Attack-execution quota: charged only to an AUTHORIZED operator, and only for state-changing (POST) operations. The key is built inside the
# authorization subrequest below, after the role check, so an anonymous or learner request can never spend it and GET polling is not counted.
map $http_x_authz_method $attack_quota_key { default ""; POST $http_x_authz_user; }
limit_req_zone $attack_quota_key zone=attack:1m rate=6r/m;
# The lab pages poll this read-only probe; per authenticated user, so it cannot be used to hammer the Attack Service's upstream probe.
limit_req_zone $binary_remote_addr zone=health:1m rate=30r/m;
limit_req_status 429;
map $remote_user $role { default learner; operator operator; }   # role comes only from the authenticated user

# Canonical external authority = the configured public host plus the configured public port (omitted for 443). The backends' same-origin check
# compares a browser's Origin (which carries a non-default port) with the Host they receive, so the Host must carry the port. It is built from
# configuration, never from a client forwarding header, and a request whose Host port differs from the configured one is refused (421).
map "${AGENTSEC_PUBLIC_PORT}" $authority_port { default ":${AGENTSEC_PUBLIC_PORT}"; 443 ""; }
map $http_host $client_port { default ""; "~:(?<p>[0-9]{1,5})$" ":$p"; }
map $client_port $client_port_norm { ":443" ""; default $client_port; }

add_header Strict-Transport-Security "max-age=31536000" always;
add_header X-Content-Type-Options nosniff always;
add_header X-Frame-Options DENY always;
add_header Referrer-Policy no-referrer always;
add_header Content-Security-Policy "frame-ancestors 'none'" always;   # a backend CSP (Academy's own) is sent as a second header: browsers enforce both, so this only adds the same restriction

# Unknown or missing SNI hostnames fail the TLS handshake.
server { listen 8443 ssl default_server; ssl_reject_handshake on; }

# Internal authorization target for the attack tier (runs after auth: anonymous 401, learner 403).
server {
  listen 127.0.0.1:8081;
  location = /_authz_operator {
    if ($http_x_authz_user != operator) { return 403; }    # role first (rewrite phase): a denied request never reaches the quota below
    limit_req zone=attack burst=5 nodelay;
    error_page 429 = @quota;
    empty_gif;                                               # a content handler: `return` would finish in the rewrite phase, before limit_req runs
  }
  location @quota { add_header X-Authz-Reason quota always; return 403; }   # auth_request cannot pass a 429 through; the caller maps this back to 429
}

server {
  listen 8443 ssl;
  server_name ${AGENTSEC_PUBLIC_HOST};
  ssl_certificate     /certs/server.pem;       # leaf + chain, mounted read-only from files
  ssl_certificate_key /certs/server.key;
  if ($client_port_norm != $authority_port) { return 421; }   # wrong or malformed Host port for this deployment
  auth_basic "AgentSecLab"; auth_basic_user_file /etc/nginx/htpasswd;
  set $attack http://attack_service:5001;
  set $gw_secret "";                           # gateway-to-backend shared secret sent upstream (identity-headers.conf): empty except where ctf-secret.conf is included (CTF locations only)
  set $fwd_prefix "";                          # X-Forwarded-Prefix sent upstream (identity-headers.conf): empty everywhere except the approved prefix below
  proxy_set_header Host $host$authority_port;
  include /etc/nginx/identity-headers.conf;

  location = / { return 302 /learn; }          # one canonical entry point
  location = /api/target-health {
    limit_except GET { deny all; }
    limit_req zone=health burst=10 nodelay;
    proxy_pass $attack;
  }
  location ~ ^/(learn(/|$)|static/|favicon\.ico$|health$|api/learn/config$|api/academy/status$|api/labs/[A-Za-z0-9_-]+$|api/missions/loan-desk/status$) {
    limit_except GET { deny all; }
    proxy_pass $attack;
  }
  # Academy-native Security Assurance: read-only GETs for any authenticated user (live and recorded views, the finding's investigation notebook context, its retest comparison and the local recorded cells). Anchored; the finding id is exactly F- plus 12 hex digits.
  location ~ "^/api/assurance/(overview|findings/F-[0-9a-f]{12}(/(investigation|comparison|explore/[a-z_]{1,40}))?|runs/[0-9a-f-]{36}/findings)$" {      # quoted: nginx would read the {12} as a block
    limit_except GET { deny all; }
    proxy_pass $attack;
  }
  # Classic Attack UI pages, Attack Service only, GET/HEAD only. ANCHORED allowlist: the captured path is rebuilt into the upstream URI, so nothing outside
  # these alternatives (and nothing matching [A-Za-z0-9_-]+ only) can reach a backend. The real AcmeBank app (5000) has no route here: the Attack Service
  # renders its own read-only /acmebank page. No dot, slash, percent or backslash can occur in the captured id.
  location = /attack-service { return 302 /attack-service/; }
  location ~ ^/attack-service/(?<asp>|labs/[A-Za-z0-9_-]+|acmebank|academy/(?:home|foundations|path|status|missions/loan-desk|labs/[A-Za-z0-9_-]+))$ {
    limit_except GET { deny all; }
    set $fwd_prefix /attack-service;           # the backend honours this header only in gateway mode and only with exactly this value
    proxy_pass $attack/$asp;
  }
  include /etc/nginx/ctf-${AGENTSEC_CTF_GATEWAY}.conf;     # CTF through the gateway: disabled (default) or enabled (needs the CTF overlay, see docs/GATEWAY.md)
  include /etc/nginx/attack-${AGENTSEC_ATTACK_TIER}.conf;
  location / { return 404; }
}
