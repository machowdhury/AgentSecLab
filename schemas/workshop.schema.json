{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsec.local/schemas/workshop.schema.json",
  "title": "AgentSec workshop content 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lab_id",
    "title",
    "tier",
    "level",
    "level_exit",
    "duration_minutes",
    "prerequisites",
    "objectives",
    "steps",
    "checks",
    "completion"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "lab_id": {
      "type": "string",
      "pattern": "^LAB-"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "enum": [
        "GUIDED MISSION",
        "WORKBENCH",
        "REPLAY",
        "CONTENT-ONLY"
      ]
    },
    "level": {
      "type": "string",
      "pattern": "^L\\d+$"
    },
    "level_exit": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "source"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "string"
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "brief"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "title": {
            "type": "string"
          },
          "brief": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "doing": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "todo": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "learn": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "answer",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria"
      ],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source_note": {
      "type": "string"
    }
  }
}
