index=agentsec_telemetry sourcetype=otel:agentic:json earliest=0 "agentsec.run.id"=__RUN_ID__ ("event.name"=agentsec.control.decision OR "event.name"=agentsec.mcp.started OR "event.name"=agentsec.mcp.completed OR "event.name"=agentsec.mcp.failed)
| eval run_id=mvindex(mvdedup('agentsec.run.id'),0)
| eval tool=mvindex(mvdedup('gen_ai.tool.name'),0)
| eval event_name=mvindex(mvdedup('event.name'),0)
| eval control_id=mvindex(mvdedup('agentsec.control.id'),0)
| eval decision=mvindex(mvdedup('agentsec.control.decision'),0)
| eval reason=mvindex(mvdedup('agentsec.control.reason'),0)
| eval requested_scope=mvindex(mvdedup('agentsec.mcp.requested_scope'),0)
| eval allowed_scope=mvindex(mvdedup('agentsec.mcp.allowed_scope'),0)
| eval hop=mvindex(mvdedup('agentsec.hop.index'),0)
| eval profile=mvindex(mvdedup('agentsec.security.profile'),0)
| eval mode=mvindex(mvdedup('agentsec.testbed.mode'),0)
| eval preview=mvindex(mvdedup('agentsec.content.preview'),0)
| eval content_hash=mvindex(mvdedup('agentsec.content.hash'),0)
| eval context_trust=mvindex(mvdedup('agentsec.rag.context.trust'),0)
| eval context_provenance=mvindex(mvdedup('agentsec.rag.context.provenance'),0)
| eval document_id=mvindex(mvdedup('agentsec.rag.context.document.id'),0)
| eval context_decision=if(control_id="CTRL-RAG-CONTEXT-001",decision,null())
| eval context_reason=if(control_id="CTRL-RAG-CONTEXT-001",reason,null())
| eval context_trust_v=if(control_id="CTRL-RAG-CONTEXT-001",context_trust,null())
| eval context_provenance_v=if(control_id="CTRL-RAG-CONTEXT-001",context_provenance,null())
| eval context_hash=if(control_id="CTRL-RAG-CONTEXT-001",content_hash,null())
| eval context_preview=if(control_id="CTRL-RAG-CONTEXT-001",preview,null())
| eval context_document_id=if(control_id="CTRL-RAG-CONTEXT-001",document_id,null())
| eval followon_tool=if(control_id="CTRL-MCP-001" AND hop="1",tool,null())
| eval followon_decision=if(control_id="CTRL-MCP-001" AND hop="1",decision,null())
| eval followon_reason=if(control_id="CTRL-MCP-001" AND hop="1",reason,null())
| eval followon_requested_scope=if(control_id="CTRL-MCP-001" AND hop="1",requested_scope,null())
| eval followon_coded_allowed_scope=if(control_id="CTRL-MCP-001" AND hop="1",allowed_scope,null())
| eval followon_started=if(event_name="agentsec.mcp.started" AND hop="1",1,0)
| eval followon_completed=if(event_name="agentsec.mcp.completed" AND hop="1",1,0)
| eval followon_failed=if(event_name="agentsec.mcp.failed" AND hop="1",1,0)
| eventstats values(context_decision) as context_decision, values(context_reason) as context_reason, values(context_trust_v) as context_trust, values(context_provenance_v) as context_provenance, values(context_hash) as context_hash, values(context_preview) as context_preview, values(context_document_id) as context_document_id, values(followon_tool) as followon_tool, values(followon_decision) as followon_decision, values(followon_reason) as followon_reason, values(followon_requested_scope) as followon_requested_scope, values(followon_coded_allowed_scope) as followon_coded_allowed_scope, max(followon_started) as followon_started, max(followon_completed) as followon_completed, max(followon_failed) as followon_failed, latest(profile) as profile, latest(mode) as mode by run_id
| eval context_decision=mvindex(mvdedup(context_decision),0)
| eval context_reason=mvindex(mvdedup(context_reason),0)
| eval context_trust=mvindex(mvdedup(context_trust),0)
| eval context_provenance=mvindex(mvdedup(context_provenance),0)
| eval context_hash=mvindex(mvdedup(context_hash),0)
| eval context_preview=mvindex(mvdedup(context_preview),0)
| eval context_document_id=mvindex(mvdedup(context_document_id),0)
| eval followon_tool=mvindex(mvdedup(followon_tool),0)
| eval followon_decision=mvindex(mvdedup(followon_decision),0)
| eval followon_reason=mvindex(mvdedup(followon_reason),0)
| eval followon_requested_scope=mvindex(mvdedup(followon_requested_scope),0)
| eval followon_coded_allowed_scope=mvindex(mvdedup(followon_coded_allowed_scope),0)
| eval derived_authority=case(match(followon_reason,"retrieved_context_derived_authority"),"present",1=1,"absent")
| eval followon_execution_observation=case(followon_completed=1,"mcp.completed_observed",followon_failed=1,"mcp.failed_observed",followon_started=1,"mcp.started_observed",followon_decision="DENY","no_indexed_followon_execution_event",isnull(followon_tool),"no_followon",1=1,"no_indexed_followon_execution_event")
| where isnotnull(context_decision) AND context_decision!=""
| dedup run_id
| table run_id, profile, mode, context_trust, context_provenance, context_document_id, context_hash, context_preview, context_decision, context_reason, derived_authority, followon_tool, followon_requested_scope, followon_coded_allowed_scope, followon_decision, followon_reason, followon_execution_observation
