index=agentsec_telemetry sourcetype=otel:agentic:json earliest=0 ("agentsec.run.id"=__WRITE_RUN_ID__ OR "agentsec.run.id"=__RECALL_RUN_ID__) ("event.name"=agentsec.memory.written OR "event.name"=agentsec.memory.recalled OR "event.name"=agentsec.control.decision OR "event.name"=agentsec.mcp.started OR "event.name"=agentsec.mcp.completed OR "event.name"=agentsec.mcp.failed)
| eval run_id=mvindex(mvdedup('agentsec.run.id'),0)
| eval event_name=mvindex(mvdedup('event.name'),0)
| eval tool=mvindex(mvdedup('gen_ai.tool.name'),0)
| eval control_id=mvindex(mvdedup('agentsec.control.id'),0)
| eval decision=mvindex(mvdedup('agentsec.control.decision'),0)
| eval reason=mvindex(mvdedup('agentsec.control.reason'),0)
| eval requested_scope=mvindex(mvdedup('agentsec.mcp.requested_scope'),0)
| eval allowed_scope=mvindex(mvdedup('agentsec.mcp.allowed_scope'),0)
| eval hop=mvindex(mvdedup('agentsec.hop.index'),0)
| eval profile=mvindex(mvdedup('agentsec.security.profile'),0)
| eval mode=mvindex(mvdedup('agentsec.testbed.mode'),0)
| eval preview=mvindex(mvdedup('agentsec.content.preview'),0)
| eval content_hash=mvindex(mvdedup('agentsec.content.hash'),0)
| eval memory_id=mvindex(mvdedup('agentsec.memory.id'),0)
| eval memory_trust=mvindex(mvdedup('agentsec.memory.trust'),0)
| eval memory_provenance=mvindex(mvdedup('agentsec.memory.provenance'),0)
| eval source_run_id=mvindex(mvdedup('agentsec.memory.source_run_id'),0)
| eval agent=mvindex(mvdedup('gen_ai.agent.id'),0)
| eval write_run_id=if(event_name="agentsec.memory.written",run_id,null())
| eval write_agent=if(event_name="agentsec.memory.written",agent,null())
| eval write_memory_id=if(event_name="agentsec.memory.written",memory_id,null())
| eval write_hash=if(event_name="agentsec.memory.written",content_hash,null())
| eval write_provenance=if(event_name="agentsec.memory.written",memory_provenance,null())
| eval write_preview=if(event_name="agentsec.memory.written",preview,null())
| eval write_source_run_id=if(event_name="agentsec.memory.written",source_run_id,null())
| eval write_profile=if(event_name="agentsec.memory.written",profile,null())
| eval write_mode=if(event_name="agentsec.memory.written",mode,null())
| eval recall_run_id=if(event_name="agentsec.memory.recalled",run_id,null())
| eval recall_agent=if(event_name="agentsec.memory.recalled",agent,null())
| eval recall_memory_id=if(event_name="agentsec.memory.recalled",memory_id,null())
| eval recall_hash=if(event_name="agentsec.memory.recalled",content_hash,null())
| eval recall_provenance=if(event_name="agentsec.memory.recalled",memory_provenance,null())
| eval recall_preview=if(event_name="agentsec.memory.recalled",preview,null())
| eval recall_source_run_id=if(event_name="agentsec.memory.recalled",source_run_id,null())
| eval recall_trust=if(event_name="agentsec.memory.recalled",memory_trust,null())
| eval recall_profile=if(event_name="agentsec.memory.recalled",profile,null())
| eval recall_mode=if(event_name="agentsec.memory.recalled",mode,null())
| eval memory_decision=if(control_id="CTRL-MEMORY-CONTEXT-001",decision,null())
| eval memory_reason=if(control_id="CTRL-MEMORY-CONTEXT-001",reason,null())
| eval memory_trust_ctrl=if(control_id="CTRL-MEMORY-CONTEXT-001",memory_trust,null())
| eval followon_tool=if(control_id="CTRL-MCP-001" AND hop="1",tool,null())
| eval followon_decision=if(control_id="CTRL-MCP-001" AND hop="1",decision,null())
| eval followon_reason=if(control_id="CTRL-MCP-001" AND hop="1",reason,null())
| eval followon_requested_scope=if(control_id="CTRL-MCP-001" AND hop="1",requested_scope,null())
| eval followon_coded_allowed_scope=if(control_id="CTRL-MCP-001" AND hop="1",allowed_scope,null())
| eval followon_started=if(event_name="agentsec.mcp.started" AND hop="1",1,0)
| eval followon_completed=if(event_name="agentsec.mcp.completed" AND hop="1",1,0)
| eval followon_failed=if(event_name="agentsec.mcp.failed" AND hop="1",1,0)
| stats values(write_run_id) as write_run_id, values(write_agent) as write_agent, values(write_memory_id) as write_memory_id, values(write_hash) as write_hash, values(write_provenance) as write_provenance, values(write_preview) as write_preview, values(write_source_run_id) as write_source_run_id, values(write_profile) as write_profile, values(write_mode) as write_mode, values(recall_run_id) as recall_run_id, values(recall_agent) as recall_agent, values(recall_memory_id) as recall_memory_id, values(recall_hash) as recall_hash, values(recall_provenance) as recall_provenance, values(recall_preview) as recall_preview, values(recall_source_run_id) as recall_source_run_id, values(recall_trust) as recall_trust, values(recall_profile) as recall_profile, values(recall_mode) as recall_mode, values(memory_decision) as memory_decision, values(memory_reason) as memory_reason, values(memory_trust_ctrl) as memory_trust_ctrl, values(followon_tool) as followon_tool, values(followon_decision) as followon_decision, values(followon_reason) as followon_reason, values(followon_requested_scope) as followon_requested_scope, values(followon_coded_allowed_scope) as followon_coded_allowed_scope, max(followon_started) as followon_started, max(followon_completed) as followon_completed, max(followon_failed) as followon_failed
| eval write_run_id=mvindex(mvdedup(write_run_id),0)
| eval write_agent=mvindex(mvdedup(write_agent),0)
| eval write_memory_id=mvindex(mvdedup(write_memory_id),0)
| eval write_hash=mvindex(mvdedup(write_hash),0)
| eval write_provenance=mvindex(mvdedup(write_provenance),0)
| eval write_preview=mvindex(mvdedup(write_preview),0)
| eval write_source_run_id=mvindex(mvdedup(write_source_run_id),0)
| eval write_profile=mvindex(mvdedup(write_profile),0)
| eval write_mode=mvindex(mvdedup(write_mode),0)
| eval recall_run_id=mvindex(mvdedup(recall_run_id),0)
| eval recall_agent=mvindex(mvdedup(recall_agent),0)
| eval recall_memory_id=mvindex(mvdedup(recall_memory_id),0)
| eval recall_hash=mvindex(mvdedup(recall_hash),0)
| eval recall_provenance=mvindex(mvdedup(recall_provenance),0)
| eval recall_preview=mvindex(mvdedup(recall_preview),0)
| eval recall_source_run_id=mvindex(mvdedup(recall_source_run_id),0)
| eval recall_trust=mvindex(mvdedup(recall_trust),0)
| eval recall_profile=mvindex(mvdedup(recall_profile),0)
| eval recall_mode=mvindex(mvdedup(recall_mode),0)
| eval memory_decision=mvindex(mvdedup(memory_decision),0)
| eval memory_reason=mvindex(mvdedup(memory_reason),0)
| eval memory_trust=mvindex(mvdedup(memory_trust_ctrl),0)
| eval followon_tool=mvindex(mvdedup(followon_tool),0)
| eval followon_decision=mvindex(mvdedup(followon_decision),0)
| eval followon_reason=mvindex(mvdedup(followon_reason),0)
| eval followon_requested_scope=mvindex(mvdedup(followon_requested_scope),0)
| eval followon_coded_allowed_scope=mvindex(mvdedup(followon_coded_allowed_scope),0)
| eval memory_id=coalesce(write_memory_id,recall_memory_id)
| eval write_recall_linked=if(recall_source_run_id=write_run_id AND write_hash=recall_hash AND write_memory_id=recall_memory_id,"linked","not_linked")
| eval fingerprint_survived=if(write_hash=recall_hash,"same_sha256","different_or_missing")
| eval derived_authority=case(match(followon_reason,"memory_derived_authority"),"present",1=1,"absent")
| eval followon_execution_observation=case(followon_completed=1,"mcp.completed_observed",followon_failed=1,"mcp.failed_observed",followon_started=1,"mcp.started_observed",followon_decision="DENY","no_indexed_followon_execution_event",isnull(followon_tool) OR followon_tool="","no_followon",1=1,"no_indexed_followon_execution_event")
| where isnotnull(write_run_id) AND write_run_id!="" AND isnotnull(recall_run_id) AND recall_run_id!=""
| table write_run_id, recall_run_id, recall_source_run_id, write_recall_linked, write_agent, recall_agent, write_profile, recall_profile, write_mode, recall_mode, memory_id, write_hash, recall_hash, fingerprint_survived, write_provenance, recall_provenance, write_preview, recall_preview, memory_trust, memory_decision, memory_reason, derived_authority, followon_tool, followon_requested_scope, followon_coded_allowed_scope, followon_decision, followon_reason, followon_execution_observation
