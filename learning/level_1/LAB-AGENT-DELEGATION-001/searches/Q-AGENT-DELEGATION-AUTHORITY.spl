index=agentsec_telemetry sourcetype=otel:agentic:json earliest=0 "agentsec.run.id"=__RUN_ID__ ("event.name"=agentsec.control.decision OR "event.name"=agentsec.mcp.started OR "event.name"=agentsec.mcp.completed OR "event.name"=agentsec.mcp.failed)
| eval run_id=mvindex(mvdedup('agentsec.run.id'),0)
| eval event_name=mvindex(mvdedup('event.name'),0)
| eval hop=mvindex(mvdedup('agentsec.hop.index'),0)
| eval principal=mvindex(mvdedup('agentsec.principal.id'),0)
| eval caller=mvindex(mvdedup('agentsec.identity.caller_agent_id'),0)
| eval callee=mvindex(mvdedup('agentsec.identity.callee_agent_id'),0)
| eval claimed_scope=mvindex(mvdedup('agentsec.delegation.claimed_scope'),0)
| eval claim_trust=mvindex(mvdedup('agentsec.identity.claim.trust'),0)
| eval tool=mvindex(mvdedup('gen_ai.tool.name'),0)
| eval control_id=mvindex(mvdedup('agentsec.control.id'),0)
| eval decision=mvindex(mvdedup('agentsec.control.decision'),0)
| eval reason=mvindex(mvdedup('agentsec.control.reason'),0)
| eval requested_scope=mvindex(mvdedup('agentsec.mcp.requested_scope'),0)
| eval allowed_scope=mvindex(mvdedup('agentsec.mcp.allowed_scope'),0)
| eval resource_id=mvindex(mvdedup('agentsec.mcp.resource.id'),0)
| eval content_hash=mvindex(mvdedup('agentsec.content.hash'),0)
| eval profile=mvindex(mvdedup('agentsec.security.profile'),0)
| eval mode=mvindex(mvdedup('agentsec.testbed.mode'),0)
| eval identity_principal=if(control_id="CTRL-IDENTITY-001",principal,null())
| eval identity_caller=if(control_id="CTRL-IDENTITY-001",caller,null())
| eval identity_callee=if(control_id="CTRL-IDENTITY-001",callee,null())
| eval identity_claimed_scope=if(control_id="CTRL-IDENTITY-001",claimed_scope,null())
| eval identity_claim_trust=if(control_id="CTRL-IDENTITY-001",claim_trust,null())
| eval identity_decision=if(control_id="CTRL-IDENTITY-001",decision,null())
| eval identity_reason=if(control_id="CTRL-IDENTITY-001",reason,null())
| eval identity_claim_hash=if(control_id="CTRL-IDENTITY-001",content_hash,null())
| eval identity_requested_tool=if(control_id="CTRL-IDENTITY-001",tool,null())
| eval identity_requested_scope=if(control_id="CTRL-IDENTITY-001",requested_scope,null())
| eval mcp_tool=if(control_id="CTRL-MCP-001",tool,null())
| eval mcp_decision=if(control_id="CTRL-MCP-001",decision,null())
| eval mcp_reason=if(control_id="CTRL-MCP-001",reason,null())
| eval mcp_requested_scope=if(control_id="CTRL-MCP-001",requested_scope,null())
| eval mcp_coded_allowed_scope=if(control_id="CTRL-MCP-001",allowed_scope,null())
| eval mcp_resource_id=if(control_id="CTRL-MCP-001",resource_id,null())
| eval mcp_started=if(event_name="agentsec.mcp.started" AND hop="1",1,0)
| eval mcp_completed=if(event_name="agentsec.mcp.completed" AND hop="1",1,0)
| eval mcp_failed=if(event_name="agentsec.mcp.failed" AND hop="1",1,0)
| eventstats values(identity_principal) as identity_principal, values(identity_caller) as identity_caller, values(identity_callee) as identity_callee, values(identity_claimed_scope) as identity_claimed_scope, values(identity_claim_trust) as identity_claim_trust, values(identity_decision) as identity_decision, values(identity_reason) as identity_reason, values(identity_claim_hash) as identity_claim_hash, values(identity_requested_tool) as identity_requested_tool, values(identity_requested_scope) as identity_requested_scope, values(mcp_tool) as mcp_tool, values(mcp_decision) as mcp_decision, values(mcp_reason) as mcp_reason, values(mcp_requested_scope) as mcp_requested_scope, values(mcp_coded_allowed_scope) as mcp_coded_allowed_scope, values(mcp_resource_id) as mcp_resource_id, max(mcp_started) as has_started, max(mcp_completed) as has_completed, max(mcp_failed) as has_failed, latest(profile) as profile, latest(mode) as mode by run_id
| eval identity_principal=mvindex(mvdedup(identity_principal),0)
| eval identity_caller=mvindex(mvdedup(identity_caller),0)
| eval identity_callee=mvindex(mvdedup(identity_callee),0)
| eval identity_claimed_scope=mvindex(mvdedup(identity_claimed_scope),0)
| eval identity_claim_trust=mvindex(mvdedup(identity_claim_trust),0)
| eval identity_decision=mvindex(mvdedup(identity_decision),0)
| eval identity_reason=mvindex(mvdedup(identity_reason),0)
| eval identity_claim_hash=mvindex(mvdedup(identity_claim_hash),0)
| eval identity_requested_tool=mvindex(mvdedup(identity_requested_tool),0)
| eval identity_requested_scope=mvindex(mvdedup(identity_requested_scope),0)
| eval mcp_tool=mvindex(mvdedup(mcp_tool),0)
| eval mcp_decision=mvindex(mvdedup(mcp_decision),0)
| eval mcp_reason=mvindex(mvdedup(mcp_reason),0)
| eval mcp_requested_scope=mvindex(mvdedup(mcp_requested_scope),0)
| eval mcp_coded_allowed_scope=mvindex(mvdedup(mcp_coded_allowed_scope),0)
| eval mcp_resource_id=mvindex(mvdedup(mcp_resource_id),0)
| eval mcp_resource_observation=if(isnull(mcp_resource_id) OR mcp_resource_id="","mcp.resource.id_not_indexed_on_this_control_hop",mcp_resource_id)
| eval execution_observation=case(has_completed=1,"mcp.completed_observed",has_failed=1,"mcp.failed_observed",has_started=1,"mcp.started_observed",1=1,"no_indexed_followon_execution_event")
| where isnotnull(identity_decision) AND identity_decision!=""
| dedup run_id
| table run_id, profile, mode, identity_principal, identity_caller, identity_callee, identity_claim_trust, identity_claimed_scope, identity_decision, identity_reason, identity_claim_hash, identity_requested_tool, identity_requested_scope, mcp_tool, mcp_requested_scope, mcp_coded_allowed_scope, mcp_resource_observation, mcp_decision, mcp_reason, execution_observation
