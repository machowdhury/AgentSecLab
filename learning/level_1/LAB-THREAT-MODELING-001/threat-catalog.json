          "placement": "HTTP input boundary",
          "evidence": "src/agentsec/pipeline.py:run_loan_pipeline"
        },
        {
          "id": "CTRL-RAG-CONTEXT-001",
          "class": "OBSERVE",
          "placement": "Retrieved-context boundary",
          "evidence": "src/agentsec/rag/pipeline.py:run_rag_retrieve"
        }
      ],
      "telemetry_required": ["input hash", "document ID", "provenance", "control decision", "follow-on request"],
      "gap": "Semantic resistance outside controlled fixtures is NOT PROVEN.",
