  "hints": [
    {
      "id": "HINT_1",
      "text": "Start with purpose and assets. Select only assets whose compromise would matter to this bounded scenario."
    },
    {
      "id": "HINT_2",
      "text": "Trace one important flow from source to destination. Mark every place where trust or authority changes."
    },
    {
      "id": "HINT_3",
      "text": "Separate what can influence the agent from what can exercise authority. Name the actual enforcement point."
    },
    {
      "id": "HINT_4",
      "text": "For each threat, bind asset → boundary → control placement → telemetry → gap → residual risk. Use NOT MODELED or NOT PROVEN when required."
    }
