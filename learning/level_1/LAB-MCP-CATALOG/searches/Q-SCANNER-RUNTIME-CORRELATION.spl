index=agentsec_telemetry earliest=0 ((sourcetype=agentsec:scanner:finding "event.name"=agentsec.scanner.scan "artifact.description_sha256"="__DESCRIPTION_SHA256__") OR (sourcetype=otel:agentic:json "event.name"=agentsec.control.decision "agentsec.control.id"=CTRL-MCP-METADATA-001 "agentsec.content.hash"="__DESCRIPTION_SHA256__"))
| eval corr=coalesce(mvindex(mvdedup('artifact.description_sha256'),0), mvindex(mvdedup('agentsec.content.hash'),0))
| eval evidence_kind=if(sourcetype="agentsec:scanner:finding","scanner","runtime")
| eval scan_id=mvindex(mvdedup(scan_id),0)
| eval run_id=mvindex(mvdedup('agentsec.run.id'),0)
| eval scanner_fixture=mvindex(mvdedup('artifact.fixture'),0)
| eval finding_count=mvindex(mvdedup('scan.finding_count'),0)
| eval scanner_classification=mvindex(mvdedup('scan.classification'),0)
| eval runtime_mode=mvindex(mvdedup('agentsec.testbed.mode'),0)
| eval profile=mvindex(mvdedup('agentsec.security.profile'),0)
| eval metadata_decision=mvindex(mvdedup('agentsec.control.decision'),0)
| eval metadata_reason=mvindex(mvdedup('agentsec.control.reason'),0)
| eval metadata_trust=mvindex(mvdedup('agentsec.mcp.metadata.trust'),0)
| stats values(evidence_kind) as evidence_kinds, values(scan_id) as scan_id, values(run_id) as run_id, values(scanner_fixture) as scanner_fixture, values(finding_count) as finding_count, values(scanner_classification) as scanner_classification, values(runtime_mode) as runtime_mode, values(profile) as profile, values(metadata_decision) as metadata_decision, values(metadata_reason) as metadata_reason, values(metadata_trust) as metadata_trust by corr
