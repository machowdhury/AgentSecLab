index=agentsec_telemetry sourcetype=otel:agentic:json earliest=0 "agentsec.run.id"=__RUN_ID__ ("event.name"=agentsec.control.decision OR "event.name"=agentsec.mcp.started OR "event.name"=agentsec.mcp.completed OR "event.name"=agentsec.mcp.failed)
| eval run_id=mvindex(mvdedup('agentsec.run.id'),0)
| eval tool=mvindex(mvdedup('gen_ai.tool.name'),0)
| eval event_name=mvindex(mvdedup('event.name'),0)
| eval control_id=mvindex(mvdedup('agentsec.control.id'),0)
| eval decision=mvindex(mvdedup('agentsec.control.decision'),0)
| eval reason=mvindex(mvdedup('agentsec.control.reason'),0)
| eval requested_scope=mvindex(mvdedup('agentsec.mcp.requested_scope'),0)
| eval allowed_scope=mvindex(mvdedup('agentsec.mcp.allowed_scope'),0)
| eval hop=mvindex(mvdedup('agentsec.hop.index'),0)
| eval profile=mvindex(mvdedup('agentsec.security.profile'),0)
| eval mode=mvindex(mvdedup('agentsec.testbed.mode'),0)
| eval preview=mvindex(mvdedup('agentsec.content.preview'),0)
| eval content_hash=mvindex(mvdedup('agentsec.content.hash'),0)
| eval metadata_trust=mvindex(mvdedup('agentsec.mcp.metadata.trust'),0)
| eval metadata_provenance=mvindex(mvdedup('agentsec.mcp.metadata.provenance'),0)
| eval metadata_decision=if(control_id="CTRL-MCP-METADATA-001",decision,null())
| eval metadata_reason=if(control_id="CTRL-MCP-METADATA-001",reason,null())
| eval metadata_trust_v=if(control_id="CTRL-MCP-METADATA-001",metadata_trust,null())
| eval metadata_provenance_v=if(control_id="CTRL-MCP-METADATA-001",metadata_provenance,null())
| eval metadata_hash=if(control_id="CTRL-MCP-METADATA-001",content_hash,null())
| eval metadata_preview=if(control_id="CTRL-MCP-METADATA-001",preview,null())
| eval initial_tool=if(control_id="CTRL-MCP-001" AND hop="0",tool,null())
| eval initial_decision=if(control_id="CTRL-MCP-001" AND hop="0",decision,null())
| eval initial_reason=if(control_id="CTRL-MCP-001" AND hop="0",reason,null())
| eval server_owned_allowed_scope=if(control_id="CTRL-MCP-001" AND hop="0",allowed_scope,null())
| eval followon_tool=if(control_id="CTRL-MCP-001" AND hop="1",tool,null())
| eval followon_decision=if(control_id="CTRL-MCP-001" AND hop="1",decision,null())
| eval followon_reason=if(control_id="CTRL-MCP-001" AND hop="1",reason,null())
| eval followon_requested_scope=if(control_id="CTRL-MCP-001" AND hop="1",requested_scope,null())
| eval followon_coded_allowed_scope=if(control_id="CTRL-MCP-001" AND hop="1",allowed_scope,null())
| eval followon_started=if(event_name="agentsec.mcp.started" AND hop="1",1,0)
| eval followon_completed=if(event_name="agentsec.mcp.completed" AND hop="1",1,0)
| eventstats values(metadata_decision) as metadata_decision, values(metadata_reason) as metadata_reason, values(metadata_trust_v) as metadata_trust, values(metadata_provenance_v) as metadata_provenance, values(metadata_hash) as metadata_hash, values(metadata_preview) as metadata_preview, values(initial_tool) as initial_tool, values(initial_decision) as initial_decision, values(initial_reason) as initial_reason, values(server_owned_allowed_scope) as server_owned_allowed_scope, values(followon_tool) as followon_tool, values(followon_decision) as followon_decision, values(followon_reason) as followon_reason, values(followon_requested_scope) as followon_requested_scope, values(followon_coded_allowed_scope) as followon_coded_allowed_scope, max(followon_started) as followon_started, max(followon_completed) as followon_completed, latest(profile) as profile, latest(mode) as mode by run_id
| eval metadata_decision=mvindex(mvdedup(metadata_decision),0)
| eval metadata_reason=mvindex(mvdedup(metadata_reason),0)
| eval metadata_trust=mvindex(mvdedup(metadata_trust),0)
| eval metadata_provenance=mvindex(mvdedup(metadata_provenance),0)
| eval metadata_hash=mvindex(mvdedup(metadata_hash),0)
| eval metadata_preview=mvindex(mvdedup(metadata_preview),0)
| eval initial_tool=mvindex(mvdedup(initial_tool),0)
| eval initial_decision=mvindex(mvdedup(initial_decision),0)
| eval initial_reason=mvindex(mvdedup(initial_reason),0)
| eval server_owned_allowed_scope=mvindex(mvdedup(server_owned_allowed_scope),0)
| eval followon_tool=mvindex(mvdedup(followon_tool),0)
| eval followon_decision=mvindex(mvdedup(followon_decision),0)
| eval followon_reason=mvindex(mvdedup(followon_reason),0)
| eval followon_requested_scope=mvindex(mvdedup(followon_requested_scope),0)
| eval followon_coded_allowed_scope=mvindex(mvdedup(followon_coded_allowed_scope),0)
| eval derived_authority=case(match(followon_reason,"metadata_derived_authority"),"present",1=1,"absent")
| eval followon_execution_observation=case(followon_completed=1,"mcp.completed_observed",followon_started=1,"mcp.started_observed",followon_decision="DENY","no_indexed_followon_execution_event",isnull(followon_tool),"no_followon",1=1,"no_indexed_followon_execution_event")
| where isnotnull(metadata_decision) AND metadata_decision!=""
| dedup run_id
| table run_id, profile, mode, metadata_trust, metadata_provenance, metadata_hash, metadata_preview, metadata_decision, metadata_reason, initial_tool, initial_decision, initial_reason, server_owned_allowed_scope, derived_authority, followon_tool, followon_requested_scope, followon_coded_allowed_scope, followon_decision, followon_reason, followon_execution_observation
