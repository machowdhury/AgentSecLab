| makeresults count=2
| streamstats count as row
| eval evidence_class="SIMULATED"
| eval "agentsec.run.id"="simulated-q-llm-after-deny-0001"
| eval "agentsec.hop.index"="0"
| eval "event.name"=if(row=1,"agentsec.control.decision","agentsec.llm.started")
| eval "agentsec.control.decision"=if(row=1,"DENY",null())
| eval "agentsec.sequence"=if(row=1,"3","4")
| eval run_id=mvindex(mvdedup('agentsec.run.id'),0)
| eval hop_index=mvindex(mvdedup('agentsec.hop.index'),0)
| eval event_name=mvindex(mvdedup('event.name'),0)
| eval decision=mvindex(mvdedup('agentsec.control.decision'),0)
| eval sequence=tonumber(mvindex(mvdedup('agentsec.sequence'),0))
| eval is_deny=if(event_name="agentsec.control.decision" AND decision="DENY",1,0)
| eval is_llm=if(match(event_name,"^agentsec\\.llm\\."),1,0)
| eventstats min(eval(if(is_deny=1,sequence,null()))) as deny_seq, max(is_deny) as has_deny by run_id, hop_index
| where has_deny=1 AND is_llm=1 AND sequence>deny_seq
| table run_id, hop_index, deny_seq, sequence, event_name, decision, evidence_class
