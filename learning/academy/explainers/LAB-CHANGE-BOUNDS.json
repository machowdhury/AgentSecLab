  "summary": {
    "text": "An agent holds authority to inspect a resource. This checkpoint asks what happens when it submits a delete instead, and what a started action does and does not prove, using three simulated cases and no real cloud account.",
    "grounds": [
      "splunk_app/agentsec/default/data/ui/views/ws_lab_change_bounds.xml"
    ],
    "facts": [
      "Tool access is not change authority."
    ]
  },
  "glance": [
    {
      "id": "operation",
      "label": "The legitimate workflow",
      "text": "The agent inspects a resource. Inspection was delegated and approved.",
      "grounds": [
        "splunk_app/agentsec/default/data/ui/views/ws_lab_change_bounds.xml"
      ],
      "facts": [
        "BASELINE submits inspect_resource."
      ]
    },
    {
      "id": "controls",
      "label": "The threat",
      "text": "The agent submits a delete instead of the inspection it was delegated and approved to do.",
      "grounds": [
        "splunk_app/agentsec/default/data/ui/views/ws_lab_change_bounds.xml"
      ],
      "facts": [
        "ATTACK and RETEST submit delete_resource. The delegated and approved operation is inspect_resource."
      ]
    },
    {
      "id": "boundary",
      "label": "The trust boundary",
      "text": "Between the operation that was granted and the change that was requested. Change authority is not unlimited blast radius.",
      "grounds": [
        "splunk_app/agentsec/default/data/ui/views/ws_lab_change_bounds.xml"
      ],
      "facts": [
        "Change authority is not unlimited blast radius."
      ]
    },
    {
      "id": "rule",
      "label": "The security control",
      "text": "Tool access does not by itself authorize a change. The tool decision decides.",
      "grounds": [
        "splunk_app/agentsec/default/data/ui/views/ws_lab_change_bounds.xml"
      ],
      "facts": [
        "Tool access is not change authority."
      ]
    },
    {
      "id": "evidence",
      "label": "What the evidence can and cannot show",
      "text": "A started action is not a successful change, and rollback is not recorded.",
      "grounds": [
        "splunk_app/agentsec/default/data/ui/views/ws_lab_change_bounds.xml"
      ],
      "facts": [
        "A start is not a successful change."
      ]
    }
