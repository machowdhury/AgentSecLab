  "summary": {
    "text": "A code-generation agent was delegated and approved to read a repository. This checkpoint looks at what happens when it submits a different operation, using three simulated cases and no real repository.",
    "grounds": [
      "splunk_app/agentsec/default/data/ui/views/ws_lab_code_agent_bounds.xml"
    ],
    "facts": [
      "A code-generation agent's authority must be bounded and evidenced."
    ]
  },
  "glance": [
    {
      "id": "operation",
      "label": "The legitimate workflow",
      "text": "The agent reads a repository. The read was delegated and approved.",
      "grounds": [
        "splunk_app/agentsec/default/data/ui/views/ws_lab_code_agent_bounds.xml"
      ],
      "facts": [
        "BASELINE submits read_repository."
      ]
    },
    {
      "id": "controls",
      "label": "The threat",
      "text": "The agent submits an install instead of the read it was delegated and approved to do.",
      "grounds": [
        "splunk_app/agentsec/default/data/ui/views/ws_lab_code_agent_bounds.xml"
      ],
      "facts": [
        "ATTACK and RETEST submit install_dependency. The delegated and approved operation is read_repository."
      ]
    },
    {
      "id": "boundary",
      "label": "The trust boundary",
      "text": "Between the operation that was granted and the operation submitted. Approval of a read is not approval of an install.",
      "grounds": [
        "splunk_app/agentsec/default/data/ui/views/ws_lab_code_agent_bounds.xml"
      ],
      "facts": [
        "Approval of a read is not approval of an install."
      ]
    },
    {
      "id": "rule",
      "label": "The security control",
      "text": "A current credential is not a tool grant, and delegation is not authorization.",
      "grounds": [
        "splunk_app/agentsec/default/data/ui/views/ws_lab_code_agent_bounds.xml"
      ],
      "facts": [
        "Delegation is not authorization."
      ]
    },
    {
      "id": "evidence",
      "label": "What the evidence can and cannot show",
      "text": "The packet records no pull request and no deploy, and resource impact stays unproven.",
      "grounds": [
        "splunk_app/agentsec/default/data/ui/views/ws_lab_code_agent_bounds.xml"
      ],
      "facts": [
        "Resource impact is NOT PROVEN."
      ]
    }
  ],
