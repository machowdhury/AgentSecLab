        "splunk_app/agentsec/default/data/ui/views/ws_lab_hitl_approval.xml"
      ],
      "facts": [
        "An approval exists for lookup_policy / lending-basics."
      ]
    },
    {
      "id": "controls",
      "label": "The threat",
      "text": "An action that differs from the approved one arrives while the approval is still inside its time window.",
      "grounds": [
        "splunk_app/agentsec/default/data/ui/views/ws_lab_hitl_approval.xml"
      ],
      "facts": [
        "The approval covers lookup_policy on lending-basics."
      ]
    },
    {
      "id": "boundary",
      "label": "The trust boundary",
      "text": "Between the approval record and the action actually submitted. An approval is bound to one action, not to a time window alone.",
      "grounds": [
        "splunk_app/agentsec/default/data/ui/views/ws_lab_hitl_approval.xml"
      ],
      "facts": [
        "You are reviewing whether an approval still covers the action that was submitted."
      ]
    },
    {
      "id": "rule",
      "label": "The security control",
      "text": "The tool decision stays with CTRL-MCP-001. The packet's binding comparison is evidence, not the decision.",
      "grounds": [
        "splunk_app/agentsec/default/data/ui/views/ws_lab_hitl_approval.xml"
      ],
      "facts": [
        "CTRL-MCP-001 remains the tool decision."
      ]
    },
    {
      "id": "evidence",
      "label": "What the evidence can and cannot show",
      "text": "The packet is a simulated approval, not a runtime approval service.",
      "grounds": [
