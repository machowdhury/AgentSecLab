    "questions": [
      {
        "id": "m1",
        "prompt": "In the ATTACK recall run, what did the memory-context control record?",
        "choices": [
          "ALLOW",
          "DENY",
          "ERROR",
          "OBSERVE",
          "NONE RECORDED"
        ],
        "eval": {
          "kind": "value",
          "ref": {
            "src": "event",
            "scenario": "attack",
            "stage": "recall",
            "where": {
              "control": "CTRL-MEMORY-CONTEXT-001",
              "nth": "last"
            },
            "field": "agentsec.control.decision"
          }
        },
        "quote": {
          "file": "learning/level_1/LAB-MULTI-STAGE-INCIDENT-001/control-analysis.json",
          "text": "Not the tool PDP"
        },
        "teach": "It classifies the recalled memory as data. It does not decide the tool request."
      },
      {
        "id": "m2",
        "prompt": "In the ATTACK recall run, what did CTRL-MCP-001 decide about the privileged request?",
        "choices": [
          "ALLOW",
          "DENY",
          "ERROR",
          "OBSERVE",
          "NONE RECORDED"
        ],
        "eval": {
          "kind": "value",
          "ref": {
            "src": "event",
            "scenario": "attack",
            "stage": "recall",
            "where": {
              "control": "CTRL-MCP-001",
              "nth": "last"
            },
            "field": "agentsec.control.decision"
          }
        },
        "quote": {
          "file": "learning/level_1/LAB-MULTI-STAGE-INCIDENT-001/evidence-graph.json",
          "text": "ALLOW before mcp.started; not a universal causality claim"
        },
        "teach": "Under the vulnerable profile the control's decision was ALLOW."
      },
      {
        "id": "m3",
        "prompt": "Did the handler for lookup_customer_tier begin in the ATTACK recall run?",
        "choices": [
          "yes",
          "no"
        ],
        "eval": {
          "kind": "handler",
          "scenario": "attack",
          "stage": "recall",
          "tool": "lookup_customer_tier"
        },
        "quote": {
          "file": "learning/level_1/LAB-MULTI-STAGE-INCIDENT-001/evidence-graph.json",
          "text": "ALLOW before mcp.started; not a universal causality claim"
        },
        "teach": "Execution is shown by mcp.started, separately from the decision."
      },
      {
        "id": "m4",
        "prompt": "In the RETEST recall run, what did CTRL-MCP-001 decide about the same request?",
        "choices": [
          "ALLOW",
          "DENY",
          "ERROR",
          "OBSERVE",
          "NONE RECORDED"
        ],
        "eval": {
          "kind": "value",
          "ref": {
            "src": "event",
            "scenario": "retest",
            "stage": "recall",
            "where": {
              "control": "CTRL-MCP-001",
              "nth": "last"
            },
            "field": "agentsec.control.decision"
          }
        },
        "quote": {
          "file": "learning/level_1/LAB-MULTI-STAGE-INCIDENT-001/control-analysis.json",
          "text": "control decision before handler"
        },
        "teach": "The decision comes before any handler."
      },
      {
        "id": "m5",
        "prompt": "Did the handler for lookup_customer_tier begin in the RETEST recall run?",
        "choices": [
          "yes",
          "no"
        ],
        "eval": {
          "kind": "handler",
          "scenario": "retest",
          "stage": "recall",
          "tool": "lookup_customer_tier"
        },
        "quote": {
          "file": "learning/level_1/LAB-MULTI-STAGE-INCIDENT-001/control-analysis.json",
          "text": "control decision before handler"
        },
        "teach": "No mcp.started in the pack. Corroboration, not independent proof."
      },
      {
        "id": "m6",
        "prompt": "In the BASELINE recall run, what did CTRL-MCP-001 decide?",
        "choices": [
          "ALLOW",
          "DENY",
          "ERROR",
          "OBSERVE",
          "NONE RECORDED"
        ],
        "eval": {
          "kind": "value",
          "ref": {
            "src": "event",
            "scenario": "baseline",
            "stage": "recall",
            "where": {
              "control": "CTRL-MCP-001",
              "nth": "last"
            },
            "field": "agentsec.control.decision"
          }
        },
        "quote": {
          "file": "learning/level_1/LAB-MULTI-STAGE-INCIDENT-001/incident.json",
          "text": "A privileged customer-information tool may have been requested."
        },
        "teach": "The baseline chain recorded no privileged request, so there is no decision to read."
      },
      {
        "id": "m7",
        "prompt": "In the ATTACK chain, does the recall's source_run_id equal the write run's run id?",
        "choices": [
          "same",
          "different"
        ],
        "eval": {
          "kind": "equal",
          "a": {
            "src": "event",
            "scenario": "attack",
            "stage": "recall",
            "where": {
              "event": "agentsec.memory.recalled"
            },
            "field": "agentsec.memory.source_run_id"
          },
          "b": {
            "src": "run",
            "scenario": "attack",
            "stage": "write"
          }
        },
        "quote": {
          "file": "learning/level_1/LAB-MULTI-STAGE-INCIDENT-001/evidence-graph.json",
          "text": "recall source_run_id equals write run.id"
        },
        "teach": "This is the one link between write and recall that the evidence supports directly."
