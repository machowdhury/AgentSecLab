  "summary": {
    "text": "A credential has a lifetime, and a request arrives carrying one. Does the credential's lifetime decide the tool, or does the tool control? This checkpoint works through three simulated cases and separates the credential's clock from the approval's clock.",
    "grounds": [
      "splunk_app/agentsec/default/data/ui/views/ws_lab_credential_lifetime.xml"
    ],
    "facts": [
      "Does the credential's lifetime decide the tool, or does CTRL-MCP-001?"
    ]
  },
  "glance": [
    {
      "id": "operation",
      "label": "The legitimate workflow",
      "text": "An agent presents a short-lived credential reference with a tool request. The credential has a subject, an audience, a scope and a window.",
      "grounds": [
        "splunk_app/agentsec/default/data/ui/views/ws_lab_credential_lifetime.xml"
      ],
      "facts": [
        "An expired synthetic credential is presented with a privileged tool request."
      ]
    },
    {
      "id": "controls",
      "label": "The threat",
      "text": "A credential past its window is presented with a privileged request.",
      "grounds": [
        "splunk_app/agentsec/default/data/ui/views/ws_lab_credential_lifetime.xml"
      ],
      "facts": [
        "An expired synthetic credential is presented with a privileged tool request."
      ]
    },
    {
      "id": "boundary",
      "label": "The trust boundary",
      "text": "Credential status is evidence the decision can consider. The tool control is where the decision is made.",
      "grounds": [
        "splunk_app/agentsec/default/data/ui/views/ws_lab_credential_lifetime.xml"
      ],
      "facts": [
        "Credential status is evidence the decision can consider. It is not the decision."
      ]
    },
    {
      "id": "rule",
      "label": "The security control",
      "text": "CTRL-MCP-001 stays the tool decision. A current credential does not itself authorize a tool.",
      "grounds": [
        "splunk_app/agentsec/default/data/ui/views/ws_lab_credential_lifetime.xml"
      ],
      "facts": [
        "CTRL-MCP-001 remains the tool decision."
      ]
    },
    {
      "id": "evidence",
      "label": "What the evidence can and cannot show",
      "text": "The packet holds references only. There is no secret, no OAuth token and no PKI.",
      "grounds": [
        "splunk_app/agentsec/default/data/ui/views/ws_lab_credential_lifetime.xml"
      ],
      "facts": [
        "No secret, private key, certificate, OAuth token, or production PKI is in this packet."
      ]
    }
  ],
  "known": [
    {
      "text": "The approval's expiry is a separate clock from the credential's expiry.",
      "grounds": [
        "learning/level_1/LAB-CREDENTIAL-LIFETIME/evidence.packet.json"
