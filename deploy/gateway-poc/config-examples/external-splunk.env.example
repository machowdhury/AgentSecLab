# Only the AGENTSEC_SPLUNK_PROBE_* names exist in product code today (src/agentsec/evidence_readiness.py); the POC tests them.
AGENTSEC_SPLUNK_PROBE_ENABLED=true
AGENTSEC_SPLUNK_PROBE_URL=https://splunk.example.org:8089            # https only; hostname must match the certificate
AGENTSEC_SPLUNK_PROBE_CA_FILE=/run/secrets/agentsec/splunk-ca.pem    # trust anchor for Splunk ONLY (separate from the gateway certificate)
AGENTSEC_SPLUNK_PROBE_TOKEN=<least-privilege search token>           # PROPOSED: AGENTSEC_SPLUNK_SEARCH_TOKEN_FILE=/run/secrets/...
