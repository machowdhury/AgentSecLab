# PROPOSED contract names. Files are mounted read-only; nothing here contains key material.
AGENTSEC_TLS_MODE=ORG_CERT
AGENTSEC_TLS_CERT_FILE=/run/secrets/agentsec/server-with-chain.pem   # leaf + intermediates
AGENTSEC_TLS_KEY_FILE=/run/secrets/agentsec/server.key               # mode 0400
AGENTSEC_PUBLIC_URL=https://agentsec.example.org
