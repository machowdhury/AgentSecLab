{
 "schema": "agentsec.governance.v1",
 "title": "Governance and Compliance Center",
 "distinctions": [
  {
   "name": "Framework relevance",
   "meaning": "A framework names a risk or technique the scenario resembles. It says nothing about whether anything was done.",
   "where": "relationships"
  },
  {
   "name": "Proposed control mapping",
   "meaning": "A person or the lab proposes that a control relates to a framework item. The reference file marks each relationship PROPOSED or RELATED.",
   "where": "relationships"
  },
  {
   "name": "Observed technical evidence",
   "meaning": "A decision or event recorded in a committed run.",
   "where": "controls[].recorded_decisions"
  },
  {
   "name": "Evaluation outcome",
   "meaning": "What an EVAL Center experiment produced. One recorded run, not a rate.",
   "where": "findings"
  },
  {
   "name": "Analyst assessment",
   "meaning": "A person's impact, likelihood and treatment. It lives in the Risk Center's local draft and is never held or shown here.",
   "where": null
  },
  {
   "name": "Control attestation",
   "meaning": "A named owner stating a control operates. None is recorded for any control.",
   "where": null
  },
  {
   "name": "Independent verification",
   "meaning": "A verifier receipt for the evidence. None applies to any run.",
   "where": null
  },
  {
   "name": "Formal compliance or certification",
   "meaning": "A conclusion by a qualified assessor against a framework. None exists and none is claimed.",
   "where": null
  }
 ],
